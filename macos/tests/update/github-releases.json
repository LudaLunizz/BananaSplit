ploaded","size":723288,"digest":"sha256:b7032402e0195141f50d1bfa446dffab918c80630e01d03c31feb40961fc94ff","download_count":0,"created_at":"2026-10-25T16:22:21Z","updated_at":"2026-10-25T16:22:21Z","browser_download_url":"https://github.com/LudaLunizz/BananaSplit/releases/download/v2.7.3/bananasplit_2.7.3_amd64.deb"},{"url":"https://api.github.com/repos/LudaLunizz/BananaSplit/releases/assets/675513579","id":675513579,"node_id":"RA_kwDOVOJ__84oQ4Tr","name":"SHA256SUMS.txt","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":398,"digest":"sha256:59d1af9b7059b9ac59e9c283d7cdb03188ab26dfc386739e673f7334f057f44e","download_count":0,"created_at":"2026-10-25T16:22:21Z","updated_at":"2026-10-25T16:22:21Z","browser_download_url":"https://github.com/LudaLunizz/BananaSplit/releases/download/v2.7.3/SHA256SUMS.txt"}],"tarball_url":"https://api.github.com/repos/LudaLunizz/BananaSplit/tarball/v2.7.3","zipball_url":"https://api.github.com/repos/LudaLunizz/BananaSplit/zipball/v2.7.3","body":"BananaSplit 2.7.3 for Linux and Windows. There is no 2.7.2.\r\n\r\n## Downloads\r\n\r\n- **Linux:** `bananasplit_2.7.3_amd64.deb` (Debian/Ubuntu) or `bananasplit-2.7.3-linux-x86_64.tar.gz`\r\n- **Windows:** `bananasplit-2.7.3-windows-x64.exe` (standalone) or the `.zip`\r\n- `SHA256SUMS.txt` to check the files\r\n\r\n## Fixes (both platforms)\r\n\r\n- Saving the config or a scene through a symlink keeps the link and the file's permissions.\r\n- Configs and scenes with a UTF-8 byte order mark load, and such scenes are listed.\r\n- The page reconnects after the event stream is refused (\"too many windows open\").\r\n- VBAN: senders that don't number their packets, or restart with lower numbers, no longer count as late packets; \"N dropouts\" counts only real dropouts and resets when the stream is switched off.\r\n- Takes are ordered correctly: `-10` after `-2`, and across a daylight-saving clock change.\r\n- A channel label never ends in `_part<n>`, so 4 GiB splits group correctly.\r\n- A mix and a multi-track take started in the same second no longer get the same name.\r\n\r\n## Linux\r\n\r\n- `--gui` and `--quit` only talk to a BananaSplit run by the same user.\r\n- \"Start with the system\" starts the app-menu copy when that is installed.\r\n\r\n## Windows\r\n\r\n- Only this user, in this session, can drive the mixer's local API.\r\n- Start-up messages (VB-Audio cable missing, port busy, connection errors) now show in the page's status line instead of being lost.\r\n- \"Start with Windows\" only shows as on when it starts this copy; ticking it points the entry here.\r\n- The tray icon waits for the taskbar at login instead of giving up.\r\n- `@default` never follows Windows into a VB-Audio cable, which caused feedback loops or silence; it uses the real device and says so."},{"url":"https://api.github.com/repos/LudaLunizz/BananaSplit/releases/423168693","assets_url":"https://api.github.com/repos/LudaLunizz/BananaSplit/releases/423168693/assets","upload_url":"https://uploads.github.com/repos/LudaLunizz/BananaSplit/releases/423168693/assets{?name,label}","html_url":"https://github.com/LudaLunizz/BananaSplit/releases/tag/v2.7.1","id":423168693,"author":{"login":"LudaLunizz","id":33155561,"node_id":"MDQ6VXNlcjMzMTU1NTYx","avatar_url":"https://avatars.githubusercontent.com/u/33155561?v=4","gravatar_id":"","url":"https://api.github.com/users/LudaLunizz","html_url":"https://github.com/LudaLunizz","followers_url":"https://api.github.com/users/LudaLunizz/followers","following_url":"https://api.github.com/users/LudaLunizz/following{/other_user}","gists_url":"https://api.github.com/users/LudaLunizz/gists{/gist_id}","starred_url":"https://api.github.com/users/LudaLunizz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LudaLunizz/subscriptions","organizations_url":"https://api.github.com/users/LudaLunizz/orgs","repos_url":"https://api.github.com/users/LudaLunizz/repos","events_url":"https://api.github.com/users/LudaLunizz/events{/privacy}","received_events_url":"https://api.github.com/users/LudaLunizz/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOVOJ__84ZOQq1","tag_name":"v2.7.1","target_commitish":"main","name":"BananaSplit. v2.7.1","draft":false,"immutable":false,"prerelease":true,"created_at":"2026-10-25T15:11:21Z","updated_at":"2026-10-25T15:55:38Z","published_at":"2026-10-25T05:32:09Z","assets":[{"url":"https://api.github.com/repos/LudaLunizz/BananaSplit/releases/assets/674207944","id":674207944,"node_id":"RA_kwDOVOJ__84oL5jI","name":"bananasplit-2.7.1-linux-x86_64.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://gi