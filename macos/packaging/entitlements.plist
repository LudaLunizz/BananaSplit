<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Inputs (microphones, sound cards, virtual cables). Without the
	     hardened runtime macOS doesn't need it, but with it (a Developer
	     ID signature) a missing entitlement silences every input without
	     asking. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
