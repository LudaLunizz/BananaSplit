# The app-menu entry of the packages (/usr/share/applications/bananasplit.desktop).
# Installed by hand instead: `bananasplit --install` writes your own copy, with
# the full path of the program and the icons, so you do not need this file.
[Desktop Entry]
Type=Application
Name=BananaSplit
GenericName=Virtual audio mixer
Comment=Mix, route and record audio: 6 strips, 5 buses, EQ, VBAN and a recorder
TryExec=bananasplit
Exec=bananasplit --gui
Icon=bananasplit
Terminal=false
StartupNotify=true
StartupWMClass=bananasplit
Categories=AudioVideo;Audio;Mixer;
Keywords=mixer;audio;jack;pipewire;recorder;voicemeeter;vban;
Actions=quit;

[Desktop Action quit]
Name=Quit BananaSplit
Exec=bananasplit --quit
