#!/usr/bin/env python3
"""Fake pactl for the end-to-end and GUI tests.

Logs every call to $PACTL_LOG and keeps the loaded modules in
$PACTL_LOG.modules (seeded with a stale BananaSplit cable, id 7, and a
module that is not ours, id 9). With PACTL_DEVICES set it also reports the
review's devices: a Razer Kiyo webcam and a Blue Yeti (mic + headphone
output). Loaded null sinks show up as sinks (Audio/Sink) or sources
(Audio/Source/Virtual), index 1000 + module id. With PACTL_REUSE_IDS set,
the id unloaded last goes to the next module loaded, as in pipewire-pulse.

With PACTL_STREAMS set, apps' streams are kept in $PACTL_LOG.streams
(Discord and Firefox playing on the Yeti, OBS recording the Yeti), listed by
`list sink-inputs` / `list source-outputs` and moved by `move-sink-input` /
`move-source-output`; unloading a cable moves its streams to the default
device, like PipeWire. `subscribe` prints an event whenever that state
changes, until BananaSplit (its parent) is gone, and writes the files it
inherited to $PACTL_LOG.subscribe-fds.

PACTL_MORE_DEVICES adds a second sound card ("system", an output and an
input); `set-default-sink` / `set-default-source` change the defaults (kept
in $PACTL_LOG.defaults), as the sound settings do. Writing
$PACTL_LOG.restart ends `subscribe`, as a restart of pipewire-pulse does;
PACTL_SUBSCRIBE_FAILS makes it end at once. While $PACTL_LOG.loadfail
exists, `load-module` fails.
"""
import json
import os
import sys
import time

LOG = os.environ.get("PACTL_LOG", "/dev/null")
args = sys.argv[1:]
with open(LOG, "a") as f:
    f.write("pactl " + " ".join(args) + "\n")
MODS = LOG + ".modules"
STREAMS = LOG + ".streams"
DEVICES = bool(os.environ.get("PACTL_DEVICES"))

if not os.path.exists(MODS):
    with open(MODS, "w") as f:
        f.write("7\tmodule-null-sink\tsink_name=bananasplit_in3 sink_properties=device.description=old\n"
                "9\tmodule-null-sink\tsink_name=someone_else\n")


def modules():
    out = []
    for line in open(MODS):
        parts = line.rstrip("\n").split("\t")
        if len(parts) >= 2:
            out.append((parts[0], parts[1], parts[2] if len(parts) > 2 else ""))
    return out


def write_modules(mods):
    with open(MODS + ".tmp", "w") as f:
        for m in mods:
            f.write("\t".join(m) + "\n")
    os.replace(MODS + ".tmp", MODS)


def arg_of(argstr, key):
    for a in argstr.split():
        if a.startswith(key + "="):
            return a[len(key) + 1:]
    return None


# (index, name, description, nick, is_source, monitor_of)
FIXED = [
    (51, "alsa_output.usb-Blue_Yeti-00.analog-stereo", "Yeti Stereo Microphone Analog Stereo", "Yeti Stereo Microphone", False, None),
    (48, "alsa_input.usb-Razer_Kiyo-02.analog-stereo", "Razer Kiyo Analog Stereo", None, True, None),
    (52, "alsa_input.usb-Blue_Yeti-00.analog-stereo", "Yeti Stereo Microphone Analog Stereo", None, True, None),
    (53, "alsa_output.usb-Blue_Yeti-00.analog-stereo.monitor", "Monitor of Yeti Stereo Microphone Analog Stereo", None, True,
     "alsa_output.usb-Blue_Yeti-00.analog-stereo"),
]
if os.environ.get("PACTL_MORE_DEVICES"):  # the "system" sound card, a second output and input
    FIXED += [
        (60, "alsa_output.pci-0000_00_1f.3.analog-stereo", "system", None, False, None),
        (61, "alsa_input.pci-0000_00_1f.3.analog-stereo", "system", None, True, None),
    ]
DEFAULT_SINK, DEFAULT_SOURCE = FIXED[0][1], FIXED[2][1]
# what `set-default-sink` / `set-default-source` chose
DEFAULTS = LOG + ".defaults"
if os.path.exists(DEFAULTS):
    DEFAULT_SINK, DEFAULT_SOURCE = open(DEFAULTS).read().split()[:2]


def devices():
    out = list(FIXED) if DEVICES else []
    for mid, mod, a in modules():
        if mod != "module-null-sink":
            continue
        name = arg_of(a, "sink_name")
        desc = arg_of(a, "node.description") or name
        src = "media.class=Audio/Source/Virtual" in a
        out.append((1000 + int(mid), name, desc, None, src, None))
    return out


def streams():
    if not os.environ.get("PACTL_STREAMS"):
        return []
    if not os.path.exists(STREAMS):
        save_streams([
            {"id": 201, "rec": False, "app": "Discord", "media": "Playback", "target": 51},
            {"id": 202, "rec": False, "app": "Firefox", "media": "YouTube", "target": 51},
            {"id": 301, "rec": True, "app": "OBS", "media": "", "target": 52},
        ])
    return json.load(open(STREAMS))


def save_streams(st):
    with open(STREAMS + ".tmp", "w") as f:
        json.dump(st, f)
    os.replace(STREAMS + ".tmp", STREAMS)


def fail(msg):
    sys.stderr.write("Failure: " + msg + "\n")
    sys.exit(1)


cmd = args[0] if args else ""
if cmd == "info":
    print("Server Name: PulseAudio (on PipeWire 1.2.7)")
    if DEVICES:
        print("Default Sink: " + DEFAULT_SINK)
        print("Default Source: " + DEFAULT_SOURCE)
elif cmd == "list":
    what = args[1] if len(args) > 1 else ""
    if what == "short":
        sys.stdout.write(open(MODS).read())
    elif what in ("sinks", "sources"):
        src = what == "sources"
        blocks = []
        for idx, name, desc, nick, is_src, mon in devices():
            if is_src != src:
                continue
            b = f"{'Source' if src else 'Sink'} #{idx}\n\tState: SUSPENDED\n\tName: {name}\n\tDescription: {desc}\n"
            if src:
                b += f"\tMonitor of Sink: {mon or 'n/a'}\n"
            else:
                b += f"\tMonitor Source: {name}.monitor\n"
            if nick:
                b += f"\tProperties:\n\t\tnode.nick = \"{nick}\"\n"
            blocks.append(b)
        sys.stdout.write("\n".join(blocks))
    elif what in ("sink-inputs", "source-outputs"):
        rec = what == "source-outputs"
        blocks = []
        for s in streams():
            if s["rec"] != rec:
                continue
            head = "Source Output" if rec else "Sink Input"
            key = "Source" if rec else "Sink"
            b = f"{head} #{s['id']}\n\tDriver: PipeWire\n\t{key}: {s['target']}\n\tProperties:\n\t\tapplication.name = \"{s['app']}\"\n"
            if s["media"]:
                b += f"\t\tmedia.name = \"{s['media']}\"\n"
            blocks.append(b)
        sys.stdout.write("\n".join(blocks))
elif cmd == "load-module" and os.path.exists(LOG + ".loadfail"):
    fail("Connection refused")  # the server is not up again yet
elif cmd == "load-module":
    free = open(LOG + ".free").read().split() if os.path.exists(LOG + ".free") else []
    if os.environ.get("PACTL_REUSE_IDS") and free:
        # like pipewire-pulse: the id unloaded last goes to the next module
        n = int(free.pop())
        with open(LOG + ".free", "w") as f:
            f.write(" ".join(free))
    else:
        try:
            n = int(open(LOG + ".n").read())
        except (OSError, ValueError):
            n = 100
        with open(LOG + ".n", "w") as f:
            f.write(str(n + 1))
    with open(MODS, "a") as f:
        f.write(f"{n}\t{args[1]}\t{' '.join(args[2:])}\n")
    print(n)
elif cmd == "unload-module":
    mods = modules()
    gone = [m for m in mods if m[0] == args[1]]
    if not gone:
        fail("No such entity")
    write_modules([m for m in mods if m[0] != args[1]])
    with open(LOG + ".free", "a") as f:
        f.write(" " + args[1])
    # PipeWire moves what played into (or recorded from) it to the default device
    st = streams()
    if st:
        for s in st:
            if s["target"] == 1000 + int(args[1]):
                s["target"] = 52 if s["rec"] else 51
        save_streams(st)
elif cmd in ("set-default-sink", "set-default-source"):
    sink, source = (args[1], DEFAULT_SOURCE) if cmd == "set-default-sink" else (DEFAULT_SINK, args[1])
    with open(DEFAULTS + ".tmp", "w") as f:
        f.write(f"{sink} {source}\n")
    os.replace(DEFAULTS + ".tmp", DEFAULTS)
elif cmd in ("move-sink-input", "move-source-output"):
    rec = cmd == "move-source-output"
    sid, name = int(args[1]), args[2]
    if name == ("@DEFAULT_SOURCE@" if rec else "@DEFAULT_SINK@"):
        name = DEFAULT_SOURCE if rec else DEFAULT_SINK
    dev = [d for d in devices() if d[1] == name and d[4] == rec]
    st = streams()
    s = [x for x in st if x["id"] == sid and x["rec"] == rec]
    if not dev or not s:
        fail("No such entity")
    s[0]["target"] = dev[0][0]
    save_streams(st)
elif cmd == "subscribe" and os.environ.get("PACTL_SUBSCRIBE_FAILS"):
    sys.stderr.write("Connection failure: Connection terminated\n")
    sys.exit(1)
elif cmd == "subscribe":
    # what it inherited from BananaSplit (it runs as long as BananaSplit does)
    with open(LOG + ".subscribe-fds", "a") as f:
        for fd in os.listdir("/proc/self/fd"):
            try:
                f.write(os.readlink(f"/proc/self/fd/{fd}") + "\n")
            except OSError:
                pass
    parent = os.getppid()
    last = None
    # $PACTL_LOG.restart written: the server went away (pipewire-pulse
    # restarted), and `pactl subscribe` ends, as the real one does
    restart = LOG + ".restart"
    restarted = os.path.getmtime(restart) if os.path.exists(restart) else 0
    while True:
        try:
            os.kill(parent, 0)
        except OSError:
            break
        if os.getppid() != parent:
            break
        if (os.path.getmtime(restart) if os.path.exists(restart) else 0) != restarted:
            sys.stderr.write("Connection failure: Connection terminated\n")
            sys.exit(1)
        now = tuple(os.path.getmtime(p) if os.path.exists(p) else 0 for p in (MODS, STREAMS, DEFAULTS))
        if last is not None and now != last:
            try:
                print("Event 'change' on sink-input #0", flush=True)
            except BrokenPipeError:
                break
        last = now
        time.sleep(0.1)
sys.exit(0)
