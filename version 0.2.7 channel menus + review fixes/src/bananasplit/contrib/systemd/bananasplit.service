# Run BananaSplit in the background for your user session.
# Install:  cp bananasplit.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now bananasplit
# Installed from the .deb: use /usr/bin/bananasplit in place of %h/.local/bin/bananasplit
# (both lines). For a mixer you can open at any time, run `bananasplit --gui --no-open`.
#
# BananaSplit removes its virtual cables when it stops, and a small watchdog process
# removes them if BananaSplit is killed. ExecStopPost covers the last case, where both
# were killed (systemctl kill -s KILL, or a stop that hit TimeoutStopSec).
[Unit]
Description=BananaSplit virtual audio mixer
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service

[Service]
ExecStart=%h/.local/bin/bananasplit --headless
ExecStopPost=-%h/.local/bin/bananasplit --cleanup
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
